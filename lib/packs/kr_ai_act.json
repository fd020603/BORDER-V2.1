{
  "pack_meta": {
    "id": "KR_AI_BASIC_ACT_v2",
    "layer": 4,
    "country_code": "KR",
    "law_name": "인공지능 발전과 신뢰 기반 조성 등에 관한 기본법 (KR AI Basic Act)",
    "version": "2026.1",
    "effective_date": "2026-01-22",
    "penalty_summary": "사전 고지 미이행 또는 과기정통부장관의 중지·시정명령 불이행 시 최대 3천만 원 이하의 과태료 (제43조제1항)",
    "adequacy_countries": []
  },
  "applicability": {
    "all": [
      {
        "any": [
          { "fact": "workspace.business_country", "operator": "equals", "value": "KR" },
          { "fact": "workspace.data_subject_countries", "operator": "includes", "value": "KR" }
        ]
      },
      {
        "any": [
          { "fact": "workspace.industry_domain", "operator": "equals", "value": "AI_SAAS" },
          {
            "fact": "transfers.detected_vendors",
            "operator": "any_vendor_matches",
            "value": { "category": "AI" }
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "rule_id": "KR-AI-31-1",
      "category": "DISCLOSURE",
      "severity": "BLOCKER",
      "article_citation": "인공지능기본법 제31조제1항, 제43조제1항제1호",
      "plain_title": "생성형 AI 기반 서비스 운용 사실 사전 고지 누락 탐지",
      "plain_explanation": "코드베이스에 외부 AI API/SDK가 연동되어 있거나 AI SaaS 도메인으로 분류되나, 처리방침 또는 이용자 안내 문서에 생성형 인공지능 기반 운용 사실에 대한 사전 고지 항목이 확인되지 않았습니다.",
      "condition_dsl": {
        "all": [
          {
            "any": [
              {
                "fact": "workspace.industry_domain",
                "operator": "equals",
                "value": "AI_SAAS"
              },
              {
                "fact": "transfers.detected_vendors",
                "operator": "any_vendor_matches",
                "value": {
                  "category": "AI"
                }
              }
            ]
          },
          {
            "any": [
              {
                "fact": "legal_doc.exists",
                "operator": "equals",
                "value": false
              },
              {
                "fact": "legal_doc.has_ai_training_opt_out_notice",
                "operator": "equals",
                "value": false
              }
            ]
          }
        ]
      },
      "drift_check": {
        "enabled": true,
        "condition": {
          "all": [
            {
              "fact": "transfers.detected_vendors",
              "operator": "any_vendor_matches",
              "value": {
                "category": "AI"
              }
            },
            {
              "fact": "legal_doc.exists",
              "operator": "equals",
              "value": true
            },
            {
              "fact": "legal_doc.has_ai_training_opt_out_notice",
              "operator": "equals",
              "value": false
            }
          ]
        },
        "alert_message": "Policy-Infra Drift 감지: 실제 코드에는 외부 AI API/SDK가 연동되어 있으나, 공개된 처리방침·약관 문서에는 AI 기반 서비스 운용 및 데이터 처리 관련 고지가 누락되어 있습니다."
      },
      "remediation": {
        "legal_template": "[인공지능 기반 서비스 이용 사전 고지]\n본 서비스의 [입력 필요: AI 기능명(예: 문서 요약, 챗봇 응답 등)]은(는) [입력 필요: 연동된 AI 모델/제공사업자명]의 생성형 인공지능 기술에 기반하여 운용됩니다. 이용자는 서비스 이용 전 해당 기능이 인공지능에 의해 제공됨을 안내받습니다.",
        "infra_patch_hint": "서비스 최초 진입 화면, AI 기능 실행 모달 또는 개인정보 처리방침·이용약관 내에 생성형 AI 기반 운용 사실을 이용자가 사전에 인지할 수 있도록 고지 UI를 추가하세요."
      }
    },
    {
      "rule_id": "KR-AI-31-2-3",
      "category": "AI_GOVERNANCE",
      "severity": "WARNING",
      "article_citation": "인공지능기본법 제31조제2항, 제31조제3항, 제40조제3항",
      "plain_title": "생성형 AI 결과물 및 가상 음향·이미지·영상 표시 체계 고지 누락 탐지",
      "plain_explanation": "생성형 AI API를 통해 텍스트·음향·이미지·영상 등 결과물을 제공하는 경우, 결과물이 AI에 의해 생성되었다는 표시(워터마크·라벨링) 및 안내가 필요합니다. 현재 처리방침에서 AI 투명성 고지 또는 거부·안내 절차가 확인되지 않아 표시 체계 반영 여부를 점검해야 합니다.",
      "condition_dsl": {
        "all": [
          {
            "any": [
              {
                "fact": "workspace.industry_domain",
                "operator": "equals",
                "value": "AI_SAAS"
              },
              {
                "fact": "transfers.detected_vendors",
                "operator": "any_vendor_matches",
                "value": {
                  "category": "AI"
                }
              }
            ]
          },
          {
            "any": [
              {
                "fact": "legal_doc.exists",
                "operator": "equals",
                "value": false
              },
              {
                "fact": "legal_doc.has_ai_training_opt_out_notice",
                "operator": "equals",
                "value": false
              },
              {
                "fact": "legal_doc.disclosed_opt_out_method",
                "operator": "equals",
                "value": false
              }
            ]
          }
        ]
      },
      "drift_check": {
        "enabled": false,
        "condition": {},
        "alert_message": ""
      },
      "remediation": {
        "legal_template": "[인공지능 생성 결과물 표시 안내]\n본 서비스가 제공하는 [입력 필요: 텍스트/이미지/음성/영상 등 결과물 유형]은(는) 생성형 인공지능에 의해 생성된 결과물이며, 이용자가 이를 명확히 인식할 수 있도록 [입력 필요: 화면 배지, 메타데이터, 워터마크 등 표시 방식]을 통해 표시됩니다.",
        "infra_patch_hint": "AI API 응답을 렌더링하는 프론트엔드 컴포넌트에 'AI 생성 결과물' 배지를 부착하고, 이미지·음성·영상 다운로드 시 C2PA 등 메타데이터 또는 가시적 워터마크가 유지되도록 파이프라인을 구성하세요."
      }
    },
    {
      "rule_id": "KR-AI-33-34-HIGH-IMPACT",
      "category": "AI_GOVERNANCE",
      "severity": "WARNING",
      "article_citation": "인공지능기본법 제2조제4호, 제33조제1항, 제34조제1항",
      "plain_title": "고영향 AI 해당 가능 도메인 사전 검토 및 신뢰성·이용자 보호 고지 누락 탐지",
      "plain_explanation": "보건의료(HEALTHCARE) 또는 대출 심사·신용평가 등 금융(FINTECH) 도메인에서 개인정보를 처리하는 외부 AI API가 연동되었으나, 처리방침에 AI 활용·학습 제외 및 이용자 보호·이의제기 안내가 확인되지 않았습니다. 고영향 인공지능 해당 여부를 검토하고 위험관리·설명 방안·사람의 관리·감독 체계를 문서화해야 합니다.",
      "condition_dsl": {
        "all": [
          {
            "any": [
              {
                "fact": "workspace.industry_domain",
                "operator": "equals",
                "value": "HEALTHCARE"
              },
              {
                "fact": "workspace.industry_domain",
                "operator": "equals",
                "value": "FINTECH"
              }
            ]
          },
          {
            "fact": "transfers.detected_vendors",
            "operator": "any_vendor_matches",
            "value": {
              "category": "AI",
              "includes_pii": true
            }
          },
          {
            "any": [
              {
                "fact": "legal_doc.exists",
                "operator": "equals",
                "value": false
              },
              {
                "fact": "legal_doc.has_ai_training_opt_out_notice",
                "operator": "equals",
                "value": false
              },
              {
                "fact": "legal_doc.disclosed_opt_out_method",
                "operator": "equals",
                "value": false
              }
            ]
          }
        ]
      },
      "drift_check": {
        "enabled": true,
        "condition": {
          "all": [
            {
              "fact": "transfers.detected_vendors",
              "operator": "any_vendor_matches",
              "value": {
                "category": "AI",
                "includes_pii": true
              }
            },
            {
              "fact": "legal_doc.has_ai_training_opt_out_notice",
              "operator": "equals",
              "value": false
            }
          ]
        },
        "alert_message": "Policy-Infra Drift 감지: 고영향 AI 검토 대상 도메인(의료·금융)에서 개인정보가 포함된 AI API 호출이 탐지되었으나, 처리방침에 AI 관련 고지 및 이용자 보호 안내가 확인되지 않았습니다."
      },
      "remediation": {
        "legal_template": "[고영향 인공지능 안전성·신뢰성 및 이용자 보호 안내]\n1. 최종결과 도출 주요 기준 및 원리: [입력 필요: AI 판단·추천에 활용되는 핵심 기준 요약]\n2. 학습용데이터 개요: [입력 필요: 활용된 데이터의 출처 및 성격 개요]\n3. 이용자 보호 및 이의제기 절차: 이용자는 인공지능 결과에 대해 [입력 필요: 담당 부서/연락처/이의제기 경로]를 통해 설명을 요구하거나 사람의 재검토를 요청할 수 있습니다.",
        "infra_patch_hint": "고영향 AI 해당 여부 사전 검토 기록을 내부 저장소에 보관하고, AI 자동 판단 결과에 대해 담당자(Human-in-the-loop)가 검토·개입할 수 있는 승인/오버라이드 로깅 기능을 구현하세요."
      }
    },
    {
      "rule_id": "KR-AI-34-1-PII-GUARD",
      "category": "AI_GOVERNANCE",
      "severity": "WARNING",
      "article_citation": "인공지능기본법 제34조제1항제1호, 제34조제1항제3호",
      "plain_title": "외부 AI API 전송 시 비식별화 및 학습 제외(Zero Data Retention) 미설정 탐지",
      "plain_explanation": "개인정보(PII)가 포함된 페이로드가 마스킹 없이 Zero Data Retention(데이터 미보관·학습 제외)이 보장되지 않은 외부 AI 벤더로 전송되고 있으며, 처리방침에 AI 학습 거부·이용자 보호 안내도 누락되어 있습니다.",
      "condition_dsl": {
        "all": [
          {
            "fact": "transfers.detected_vendors",
            "operator": "any_vendor_matches",
            "value": {
              "category": "AI",
              "includes_pii": true,
              "zero_data_retention": false
            }
          },
          {
            "fact": "security.pii_masked_before_transfer",
            "operator": "equals",
            "value": false
          },
          {
            "fact": "legal_doc.has_ai_training_opt_out_notice",
            "operator": "equals",
            "value": false
          }
        ]
      },
      "drift_check": {
        "enabled": true,
        "condition": {
          "all": [
            {
              "fact": "transfers.detected_vendors",
              "operator": "any_vendor_matches",
              "value": {
                "category": "AI",
                "includes_pii": true,
                "zero_data_retention": false
              }
            },
            {
              "fact": "legal_doc.exists",
              "operator": "equals",
              "value": true
            },
            {
              "fact": "legal_doc.has_ai_training_opt_out_notice",
              "operator": "equals",
              "value": false
            }
          ]
        },
        "alert_message": "Policy-Infra Drift 감지: 외부 AI API로 개인정보가 비식별화 없이 전송되고 있으나, 데이터 미보관(ZDR) 설정 및 처리방침 내 AI 학습 제외 안내가 모두 누락되어 있습니다."
      },
      "remediation": {
        "legal_template": "[인공지능 입력 데이터 처리 및 학습 제외 안내]\n회사는 이용자가 입력한 개인정보가 외부 인공지능 모델의 학습용 데이터로 사용되지 않도록 [입력 필요: API 학습 제외(Opt-out) 계약 또는 데이터 비식별화 조치]를 적용하고 있습니다. 데이터 처리 및 보관 기간은 [입력 필요: 구체적 보관 기간]입니다.",
        "infra_patch_hint": "외부 AI API 호출 직전 미들웨어에서 이름·전화번호·이메일 등 PII를 마스킹(Pseudonymization)하거나, AI 벤더의 Enterprise/API Zero Data Retention(ZDR) 옵션을 활성화하세요."
      }
    }
  ]
}
